    "docker": "Docker", "mqtt": "MQTT", "esp32": "ESP32", "electron": "Electron", "tauri": "Tauri", "dotnet": ".NET",
    "llm_api": "LLM API", "unity": "Unity", "threejs": "Three.js", "clickhouse": "ClickHouse", "kubernetes": "Kubernetes"
  },
