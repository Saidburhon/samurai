{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qilich-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "ratelimits": [{ "name": "SAMURAI_LIMITER", "namespace_id": "7001", "simple": { "limit": 4, "period": 60 } }],
  "routes": [{ "pattern": "qilich.com", "custom_domain": true }]
}
