{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qilich-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "vars": { "SAMURAI_DAILY_USD": "15" },
  "ratelimits": [{ "name": "SAMURAI_LIMITER", "namespace_id": "7001", "simple": { "limit": 10, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "SAMURAI_GUARD", "class_name": "SamuraiGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SamuraiGuard"] }],
  "routes": [{ "pattern": "qilich.com", "custom_domain": true }]
}
