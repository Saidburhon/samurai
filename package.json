{
  "name": "qilich-site",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "node scripts/lint-copy.mjs --built",
    "qa:fit": "node scripts/qa/fit-check.cjs",
    "qa:flow": "node scripts/qa/flow-probe.cjs",
    "dev": "wrangler dev",
