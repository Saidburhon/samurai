{
  "name": "qilich-site",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "node scripts/lint-copy.mjs --built",
    "qa:fit": "node scripts/qa/fit-check.cjs",
    "qa:flow": "node scripts/qa/flow-probe.cjs",
    "qa:poster": "node scripts/qa/poster-test.cjs",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:www": "wrangler deploy -c workers/www-redirect/wrangler.json",
    "indexnow": "node scripts/indexnow.mjs",
    "qa:seo": "node scripts/qa/seo-check.mjs",
    "qa:pages": "node scripts/qa/pages-probe.cjs",
    "qa:ja": "node scripts/qa/ja-review.mjs",
    "test": "node --test \"src/shared/*.test.js\" \"worker/*.test.js\"",
    "samples": "node scripts/samurai-samples.mjs",
    "ja:catalogue": "node scripts/samurai-ja-catalogue.mjs",
    "eval:samurai": "node scripts/eval-samurai.mjs",
    "qa:samurai": "node scripts/qa/samurai-probe.mjs",
    "qa:samurai-fixes": "node scripts/qa/samurai-fixes.cjs",
    "qa:samurai-refine": "node scripts/qa/samurai-refine.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.186.1",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
