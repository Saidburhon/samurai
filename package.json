    "deploy:www": "wrangler deploy -c workers/www-redirect/wrangler.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "^0.186.1",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0"
  }
}
